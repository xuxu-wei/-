  "p06-finite-leakage": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "C": "截断等价于乘窗，频域会扩散。",
      "D": "有限观察窗口也能产生多频点。",
      "A": "这些是窗函数的取舍，不是免费提高所有性能。",
      "B": "混叠来自采样（sampling）歧义，泄漏来自有限记录。"
    }
  },
  "p06-zero-padding": {
    "correct": [
      "C"
    ],
    "explanations": {
      "B": "记录长度没变。",
      "C": "补零在同一有限记录的频域表示上提供更密取样。",
      "D": "真正分辨能力还受原记录时长、噪声与方法影响。",
      "A": "没有平均新的独立样本。"
    }
  },
  "p06-fir-delay-band": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "核中心为(W−1)/2=2个采样（sampling）间隔。",
      "B": "该核有频率选择性。",
      "C": "零幅没有稳定相位。",
      "D": "固定分母仍含前置零值。"
    }
  },
  "p06-amplitude-calibration": {
    "correct": [
      "A"
    ],
    "explanations": {
      "D": "窗会改变幅度比例和频谱扩散。",
      "A": "标定条件也必须公开，不能过度推广。",
      "B": "旁瓣抑制与主瓣宽度存在取舍。",
      "C": "采样歧义无法凭窗自动撤销。"
    }
  },
