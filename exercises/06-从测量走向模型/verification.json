{
  "p06-cosine-samples": {
    "cases": [
      {
        "arguments": {
          "times": [
            0,
            1,
            2
          ],
          "frequency": 0.2,
          "amplitude": 1.0,
          "phase": 0.0
        },
        "expected": [
          1.0,
          0.30901699437494745,
          -0.8090169943749473
        ]
      },
      {
        "arguments": {
          "times": [
            0,
            1,
            2
          ],
          "frequency": 0.8,
          "amplitude": 1.0,
          "phase": 0.0
        },
        "expected": [
          1.0,
          0.30901699437494723,
          -0.8090169943749477
        ]
      },
      {
        "arguments": {
          "times": [
            0,
            0.25,
            0.75
          ],
          "frequency": 1.0,
          "amplitude": 2.0,
          "phase": 1.5707963267948966
        },
        "expected": [
          1.2246467991473532e-16,
          -2.0,
          2.0
        ]
      },
      {
        "arguments": {
          "times": [],
          "frequency": 0.0,
          "amplitude": 0.0,
          "phase": 0.0
        },
        "expected": []
      }
    ],
    "explanation": "采样时刻来自观测协议，不能用绘图网格替换。"
  },
  "p06-three-clocks": {
    "correct": [
      "B",
      "D"
    ],
    "explanations": {
      "D": "分别控制求解近似、读数时钟和信号处理。",
      "A": "观测仍每秒一次，高频仍可能混叠。",
      "B": "5 个点之间有4个间隔。",
      "C": "插值或画线不产生独立观测。"
    }
  },
  "p06-alias-equivalence": {
    "correct": [
      "D"
    ],
    "explanations": {
      "C": "缺少带宽前提时存在多个解释。",
      "D": "cos(2πn−0.4πn)=cos(0.4πn)。",
      "A": "该等式对所有整数 n 成立。",
      "B": "只在这些采样（sampling）时刻一致。"
    }
  },
  "p06-nyquist-conditions": {
    "correct": [
      "B",
      "D"
    ],
    "explanations": {
      "B": "这里还依赖理想带限与采样/重建前提。",
      "C": "有限时间、误差和滤波边缘均须另行处理。",
      "D": "已采样数字信号的再次降采样也需要限制新Nyquist以上成分。",
      "A": "混叠通常造成不可逆的观察歧义。"
    }
  },
  "p06-causal-average": {
    "cases": [
      {
        "arguments": {
          "values": [
            2.0,
            4.0,
            8.0,
            10.0
          ],
          "window": 3
        },
        "expected": [
          2.0,
          3.0,
          4.666666666666667,
          7.333333333333333
        ]
      },
      {
        "arguments": {
          "values": [
            3.0,
            3.0
          ],
          "window": 5
        },
        "expected": [
          3.0,
          3.0
        ]
      },
      {
        "arguments": {
          "values": [
            1.0,
            -1.0,
            2.0
          ],
          "window": 1
        },
        "expected": [
          1.0,
          -1.0,
          2.0
        ]
      },
      {
        "arguments": {
          "values": [],
          "window": 4
        },
        "expected": []
      }
    ],
    "explanation": "启动端点的归一化是算法的一部分；不可默认为固定分母零填充。"
  },
  "p06-centered-lookahead": {
    "correct": [
      "A"
    ],
    "explanations": {
      "D": "x[n+1] 在当前时刻尚未到达。",
      "A": "离线平滑与在线报告有不同信息条件。",
      "B": "未来值是否进入计算与代码长短无关。",
      "C": "两者时间对齐不同。"
    }
  },
  "p06-filter-delay": {
    "correct": [
      "A",
      "C"
    ],
    "explanations": {
      "C": "由独立样本和的方差得出。",
      "D": "频率响应（frequency response）同时改变幅度和相位。",
      "A": "线性相位由以核中点为中心的对称性产生，零点（zero）处相位未定义。",
      "B": "协方差（covariance）项一般不为零。"
    }
  },
  "p06-startup-filter": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "B": "每个前缀的均值仍是3。",
      "C": "初期缺失的前置点按0处理，分母保持3。",
      "D": "固定核的线性时不变（linear time-invariant，LTI）解释不直接覆盖前缀变分母。",
      "A": "启动响应也属于待解释结果。"
    }
  },
  "p06-linear-convolution": {
    "cases": [
      {
        "arguments": {
          "signal": [
            1.0,
            2.0,
            0.0
          ],
          "kernel": [
            0.5,
            0.5
          ]
        },
        "expected": [
          0.5,
          1.5,
          1.0,
          0.0
        ]
      },
      {
        "arguments": {
          "signal": [
            1.0
          ],
          "kernel": [
            2.0,
            -1.0,
            0.5
          ]
        },
        "expected": [
          2.0,
          -1.0,
          0.5
        ]
      },
      {
        "arguments": {
          "signal": [
            1.0,
            2.0
          ],
          "kernel": [
            0.0,
            1.0
          ]
        },
        "expected": [
          0.0,
          1.0,
          2.0
        ]
      },
      {
        "arguments": {
          "signal": [
            0.0,
            0.0
          ],
          "kernel": [
            0.0
          ]
        },
        "expected": [
          0.0,
          0.0
        ]
      }
    ],
    "explanation": "每个输入脉冲产生一份平移缩放后的核，再在同一输出时刻相加。"
  },
  "p06-lti-superposition": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "D": "线性允许展开输入并叠加。",
      "A": "时不变保证每次脉冲使用同一核的平移。",
      "B": "饱和破坏全局线性。",
      "C": "一般输出包含零输入响应（zero-input response）和零状态响应（zero-state response）。"
    }
  },
  "p06-circular-wrap": {
    "correct": [
      "C"
    ],
    "explanations": {
      "C": "该长度可以容纳完整支持，避免尾部模L回绕。",
      "D": "不足时得到叠加回绕的循环卷积（circular convolution）。",
      "A": "回绕来自计算表示，不是模型（model）机制。",
      "B": "补零只明确有限序列区间外为0。"
    }
  },
  "p06-impulse-meaning": {
    "correct": [
      "A",
      "B",
      "C"
    ],
    "explanations": {
      "B": "这就是离散脉冲响应的定义。",
      "C": "错移一位会改变响应的因果时序。",
      "D": "初态可能叠加零输入响应（zero-input response）。",
      "A": "连续冲激的面积和单位还需单独定义。"
    }
  },
  "p06-one-sided-spectrum": {
    "cases": [
      {
