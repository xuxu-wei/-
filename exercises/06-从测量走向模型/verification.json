          [
            0.0,
            0.0,
            0.0
          ]
        ]
      }
    ],
    "explanation": "偶数N的Nyquist只有一个独立实系数；奇数N的最后频点仍需要加倍。"
  },
  "p06-complex-rotation": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "D": "两个旋转角相加。",
      "A": "这让正弦系统响应的缩放与延迟（delay）可一起表示。",
      "B": "实信号DFT满足共轭对称。",
      "C": "两边虚部抵消，实部相加。"
    }
  },
  "p06-nyquist-amplitude": {
    "correct": [
      "C"
    ],
    "explanations": {
      "C": "Nyquist系数没有另一个独立负频率搭档。",
      "D": "DC和偶数长度Nyquist是例外。",
      "A": "坐标为k*fs/N，最后k=2。",
      "B": "符号每点交替，均值为0。"
    }
  },
  "p06-phase-zero": {
    "correct": [
      "A",
      "B",
      "C"
    ],
    "explanations": {
      "B": "方向无法由零向量定义。",
      "C": "阈值和返回标记属于计算契约。",
      "D": "接近零时相角容易被误差主导。",
      "A": "还需查看该频点幅值。"
    }
  },
  "p06-frequency-units": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "Δf=fs/N=0.2 Hz；有效记录跨度约N/fs。",
      "B": "这是把比值倒置了。",
      "C": "采样率（sampling rate）不是频点间隔。",
      "D": "角频率需要再乘2π。"
    }
  },
