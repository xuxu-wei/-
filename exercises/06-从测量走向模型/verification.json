  "p06-laplace-initial": {
    "correct": [
      "B"
    ],
    "explanations": {
      "B": "L{dA/dt}=sA(s)−A0。",
      "C": "只有零初态才能省略初值（initial condition）项。",
      "D": "初态改变响应权重，不改变该模型极点−k。",
      "A": "全局非线性一般不满足叠加。"
    }
  },
  "p06-linear-map-initial": {
    "correct": [
      "A",
      "B",
      "C"
    ],
    "explanations": {
      "A": "零输入响应（zero-input response）为3exp(−kt)。",
      "B": "固定附加响应破坏齐次性。",
      "C": "对(u,A0)一起缩放，解也按相同比例缩放。",
      "D": "初态影响实际输出。"
    }
  },
  "p06-roc-causal": {
    "correct": [
      "B",
      "D"
    ],
    "explanations": {
      "D": "积分从0到∞，指数实部衰减时收敛。",
      "A": "不同收敛域可对应不同左右侧信号。",
      "B": "∫|h|dt=1/k有限。",
      "C": "k=0是积分器，恒定输入可产生无界输出。"
    }
  },
  "p06-lti-failure": {
    "correct": [
      "C"
    ],
    "explanations": {
      "C": "k只依赖时间时叠加成立但平移不保持；饱和项不满足全局叠加。",
      "D": "混淆了系数时变与状态（state）非线性。",
      "A": "需要分别检查线性和时不变。",
      "B": "线性化通常只有局部适用范围。"
    }
  },
