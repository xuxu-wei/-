{
  "p13-finite-order-summary": {
    "cases": [
      {
        "arguments": {
          "paths": [
            [
              0.0,
              0.2,
              -0.4
            ],
            [
              0.0,
              -0.4,
              -0.2
            ]
          ],
          "burnin": 1
        },
        "expected": [
          0.30000000000000004,
          0.0
        ]
      },
      {
        "arguments": {
          "paths": [
            [
              1.0,
              0.5,
              0.25
            ],
            [
              -1.0,
              -0.5,
              -0.25
            ]
          ],
          "burnin": 1
        },
        "expected": [
          0.375,
          0.0
        ]
      },
      {
        "arguments": {
          "paths": [
            [
              0.0,
              0.0,
              1.0
            ],
            [
              0.0,
              0.5,
              0.5
            ]
          ],
          "burnin": 1
        },
        "expected": [
          0.5,
          0.0
        ]
      }
    ],
    "explanation": "先在重复内部取尾窗绝对值，再在重复之间汇总；不把一次轨迹的波动当成重复间不确定性。"
  },
  "p13-signed-vs-absolute": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "两个对称符号抵消，而绝对值保留偏离零的幅度。",
      "B": "绝对值不会因符号对称而抵消。",
      "C": "每个个体为 ±1 时 |m| 不超过1。",
      "D": "有限时长与规模不能直接证明热力学极限（thermodynamic limit）。"
    }
  },
  "p13-finite-fluctuation": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "磁化是 ±1 的平均，每项方差4r(1-r)，独立平均再除以 N。",
      "B": "平均会使独立抽样方差按1/N缩小。",
      "C": "确定的是条件期望（expectation），不是有限样本的下一步。",
      "D": "忽略了 N 个独立抽样的平均。"
    }
  },
  "p13-finite-evidence": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "结论严格限制在观测（observation）到的有限轨迹与规则。",
      "B": "缺少规模、长时和极限（limit）分析。",
      "C": "单次有限扫描不能提供精确阈值。",
      "D": "两者适用对象和极限不同。"
    }
  },
  "p13-deterministic-meanfield": {
    "cases": [
      {
        "arguments": {
          "beta": 0.0,
          "start": 0.4,
          "steps": 2
        },
        "expected": [
          0.4,
          0.0,
          0.0
        ]
      },
      {
        "arguments": {
          "beta": 1.2,
          "start": 0.2,
          "steps": 3
        },
        "expected": [
          0.2,
          0.23549574953849794,
          0.2753050142817213,
          0.31884962124176486
        ]
      },
      {
        "arguments": {
          "beta": 0.8,
          "start": -0.3,
          "steps": 1
        },
        "expected": [
          -0.3,
          -0.23549574953849794
        ]
      }
    ],
    "explanation": "tanh(0)=0；零步情形不应自行更新。有限随机系统还存在抽样波动。"
  },
  "p13-meanfield-threshold": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "一维离散映射的局部幅度由 |beta| 决定；beta=1 是非双曲边界。",
      "B": "有界性不等于局部稳定。",
      "C": "斜率为1时需看非线性项。",
      "D": "固定点参照不消除有限规模（finite size）与时长效应。"
    }
  },
  "p13-size-comparison": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "这些条件会影响有限规模序参量（order parameter）和阈值读数。",
      "B": "同时改变机制与窗口会混淆规模效应。",
      "C": "选择极端轨迹（trajectory）会造成偏差。",
      "D": "有限范围拟合不足以确立普适类。"
    }
  },
  "p13-critical-language": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "分别说清模型对象与证据范围。",
      "B": "有限规模曲线不能直接推出无限极限（limit）。",
      "C": "它提供条件期望（expectation）参照，但不是全部随机证据。",
      "D": "对称符号抵消时平均 |m| 很有用。"
    }
  },
