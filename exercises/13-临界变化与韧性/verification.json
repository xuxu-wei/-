  "p13-direct-vs-secondary": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "第0轮与后续各轮分开统计，累计集合去重。",
      "B": "后两轮不是外生种子。",
      "C": "累计数不能把已经失效的节点反复计数。",
      "D": "同步规则只读取上一轮失效。"
    }
  },
  "p13-cascade-no-seed": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "无人失效时每个节点见到的失效邻居数为0。",
      "B": "至少1的正阈值未满足。",
      "C": "度数不是本题的外生损伤。",
      "D": "正阈值与零种子已足以判定此边界。"
    }
  },
  "p13-cascade-is-not-contagion": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "同一图上的机制语义由更新规则决定。",
      "B": "接触概率（probability）、恢复和负载重分配等机制不同。",
      "C": "本题失效不可逆。",
      "D": "更高阈值更难触发失效。"
    }
  },
