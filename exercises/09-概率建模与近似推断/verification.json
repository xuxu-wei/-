{
  "p09-normal-update": {
    "cases": [
      {
        "arguments": {
          "prior_mean": 0.0,
          "prior_variance": 4.0,
          "observations": [
            1.0,
            3.0
          ],
          "noise_variance": 2.0
        },
        "expected": [
          1.6,
          0.8,
          2.8
        ]
      },
      {
        "arguments": {
          "prior_mean": 3.0,
          "prior_variance": 2.0,
          "observations": [],
          "noise_variance": 1.0
        },
        "expected": [
          3.0,
          2.0,
          3.0
        ]
      },
      {
        "arguments": {
          "prior_mean": -1.0,
          "prior_variance": 0.5,
          "observations": [
            -2.0
          ],
          "noise_variance": 0.25
        },
        "expected": [
          -1.6666666666666665,
          0.16666666666666666,
          0.41666666666666663
        ]
      }
    ],
    "explanation": "精度为1/4+2/2=1.25，后验均值1.6、方差0.8；新读数还含2单位噪声方差，预测方差为2.8。"
  },
