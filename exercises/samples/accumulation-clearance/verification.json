  "S02-E3": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "流出不能在耗尽后无条件持续；需限制适用时间或明确新的耗尽机制。",
      "B": "裁剪引入了额外规则，必须明确说明并重新核验。",
      "C": "物理合理性不能由程序是否报错决定。",
      "D": "失效的是当前流出假设的适用范围，而不是收支原理。"
    }
  },
  "S03-E1": {
    "correct": [
      "A"
    ],
    "explanations": {
      "A": "u=kA，抵消的是净变化，不是两个流动过程。",
      "B": "流动可以持续且相互抵消。",
      "C": "本例平衡为 u/k=2 U。",
      "D": "交换存在并不要求净流量为正。"
    }
  },
