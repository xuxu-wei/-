      "A"
    ],
    "explanations": {
      "A": "导数是单位时间变化率，积分累积流量，初值确定本次演化的起点。",
      "B": "求导增加时间分母，积分消去流率中的时间分母。",
      "C": "同一方程可对应不同初值和不同轨迹。",
      "D": "流率可以随时间变化，倍增时间不保证倍增积分。"
    }
  },
