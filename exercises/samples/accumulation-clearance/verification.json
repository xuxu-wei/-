    ],
    "explanations": {
      "A": "流率乘时间得到区间内实际转移的量，与存量同为 U。",
      "B": "存量是某时刻的物质量，不能把它写成每单位时间的量。",
      "C": "流量带有时间分母，不能与存量直接相加。",
      "D": "乘以时间后，流量单位中的 T 被约掉。"
    }
  },
