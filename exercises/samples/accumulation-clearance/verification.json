    ],
    "explanations": {
      "A": "kh 是本步比例，分别为 0.5×0.1 和 0.5×1。",
      "B": "k 不等于任何步长下都不变的每步比例。",
      "C": "应乘以步长，不能除以步长。",
      "D": "(1/T)×T 无量纲。"
    }
  },
