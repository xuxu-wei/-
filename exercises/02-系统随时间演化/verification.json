    "explanation": "保留起点，再循环 steps 次；可用 initial × factor**n 独立检查。"
  },
  "p02-sum-index": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "遗漏起点和前两段变化。",
      "B": "起点是第 0 段，三次更新用 b[0] 到 b[2]。",
      "C": "把三条递推关系（recurrence relation）相加，中间状态（state）相消。",
      "D": "初始物质量只计一次。"
    }
  },
  "p02-fixed-point": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "代入得到 0.5×2+1=2。",
      "B": "例如从 0 开始第一步只有 1。",
      "C": "按规则逐次代入即可验证。",
      "D": "两边减去 2，可得 A[n+1]−2=0.5(A[n]−2)。"
    }
  },
