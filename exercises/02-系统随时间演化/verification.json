  "p02-difference-noise": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "数值误差（numerical error）变大不能据此否定数学导数。",
      "B": "应区分近似误差与有限精度计算。",
      "C": "因此需要检查一段合理的 h 范围，而非无限缩小。",
      "D": "取整会丢掉局部变化信息。"
    }
  },
  "p02-area-unit": {
    "correct": [
