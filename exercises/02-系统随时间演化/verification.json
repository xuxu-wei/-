      "C"
    ],
    "explanations": {
      "A": "流率（flow rate）乘时间后累计为物质量。",
      "B": "遗漏起点。",
      "C": "只有流入时，末量=初量+累计流入。",
      "D": "积分带来一个时间因子，单位为 U。"
    }
  },
