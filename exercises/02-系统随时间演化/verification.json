  "p02-limit-not-zero": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "限制的是区间长度，不是自变量起点。",
      "B": "极限（limit）研究非零 h 下结果趋向哪里。",
      "C": "零数值本身合法。",
      "D": "很小的 h 只是近似，极限是数学定义。"
    }
