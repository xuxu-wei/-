{
  "p02-step-factor": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "两次 0.8 得到 0.64；改变了一个 T 内的规则。",
      "B": "该结论依赖题设补充的半步组合假设，平方后应回到 0.8。",
      "C": "比例是无量纲（dimensionless）量，需另外说明一步多长。",
      "D": "多做一次乘法会改变结果，不能只换标签。"
    }
  },
  "p02-growth": {
