    }
  },
  "p02-cap-rate-balance": {
    "correct": [
      "C"
    ],
    "explanations": {
      "A": "把速率直接加到存量上，量纲不相容；还漏了实际时长。",
      "B": "流出项 kA 仍是速率，也必须乘实际时长。",
      "C": "u 与 kA 都是 U/T；净速率乘 Δt 后得到 U，再与原存量相加。",
      "D": "A、u 和 k 的单位不同，不能直接相加减。"
    }
  },
