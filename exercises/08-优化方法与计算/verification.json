  "p08-stationary-counterexample": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "这是一个反例。",
      "B": "负曲率说明向两侧小幅移动都会下降。",
      "C": "可写成(x²−1)²/4−1/4。",
      "D": "凸函数不能有这样的中间严格局部最大。"
    }
  },
  "p08-hessian-zero": {
    "correct": [
      "B",
      "C",
      "D"
    ],
    "explanations": {
      "A": "此时二阶检验不决定结论。",
      "B": "x⁴≥0且仅在0等号。",
      "C": "−x⁴≤0且仅在0等号。",
      "D": "f₂就是反例，须看邻域或更高阶。"
    }
  },
  "p08-convex-domain": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "沿每条线段的二阶导数（derivative）非负。",
      "B": "局部曲率不能覆盖整个域。",
      "C": "一阶支撑不等式给出全域下界。",
      "D": "严格凸排除两个不同最小点；存在性另需条件。"
    }
  },
