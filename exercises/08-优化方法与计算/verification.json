  "p08-loss-units": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "每个比值无量纲，尺度的来源须说明。",
      "B": "平方仍保留单位的平方。",
      "C": "相对权重改变目标的折中。",
      "D": "正比例不改变目标值的次序。"
    }
  },
  "p08-gradient-direction": {
    "correct": [
      "B"
    ],
    "explanations": {
      "A": "方向导数（derivative）可能正、负或零。",
      "B": "gᵀ(−g)=−‖g‖²<0。",
      "C": "沿g一阶增加。",
      "D": "一阶为零，需检查高阶项。"
    }
  },
  "p08-change-coordinates": {
    "correct": [
      "B",
      "C"
    ],
    "explanations": {
      "A": "数值系数也须变换。",
      "B": "代入原二次式即可得到。",
      "C": "否则可行点或起点发生变化。",
      "D": "单项权重改变通常是另一目标。"
    }
  },
