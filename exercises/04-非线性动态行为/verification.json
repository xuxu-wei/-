{
  "p04-switch-equilibria": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "A": "令 x(1−x²)=0。",
      "B": "保持在平衡不等于抵抗扰动；0 附近的正负扰动分别离开。",
      "C": "f′=1−3x²，在 ±1 为负。",
      "D": "在 (0,1) 中向右，在 (1,∞) 中向左，终点为 1。"
    }
  },
