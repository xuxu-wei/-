  "p04-kick-basin": {
    "correct": [
      "A",
      "C",
      "D"
    ],
    "explanations": {
      "C": "扰动后为 −0.2，仍在负半轴吸引域（basin of attraction）。",
      "D": "精确为 0 是不稳定平衡（equilibrium）；并不代表鲁棒地停在那里。",
      "A": "扰动后为 0.2，进入正半轴吸引域。",
      "B": "必须跨过边界，扰动大小和方向都重要。"
    }
  },
  "p04-finite-grid": {
