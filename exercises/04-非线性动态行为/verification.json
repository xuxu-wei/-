      "C": "直接代入可得。",
      "D": "初始扰动只改变起点；持续偏置改变方程。"
    }
  },
  "p04-oscillation-source": {
    "correct": [
      "A"
    ],
    "explanations": {
      "D": "平滑性不区分振荡机制。",
