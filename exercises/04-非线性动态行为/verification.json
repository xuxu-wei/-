  "p04-zero-slope": {
    "correct": [
      "A"
    ],
    "explanations": {
      "C": "模型二的非零点向外运动。",
      "D": "模型一从两侧朝 0 移动。",
      "A": "导数为零只消除了线性项；三次项的符号给出相反方向。",
      "B": "只有函数值为零的点才保持不变。"
    }
  },
  "p04-line-no-cycle": {
    "correct": [
      "C"
    ],
    "explanations": {
      "B": "非线性不足以产生连续时间周期。",
      "C": "掉头需要经过 f=0；唯一性使经过平衡的解保持在那里。",
      "D": "离散误差也可能制造摆动。",
      "A": "离散映射可直接跳到另一侧，论证不适用。"
    }
  },
