  "p12-payoff-replicator": {
    "cases": [
      {
        "arguments": {
          "matrix": [
            [
              3.0,
              0.0
            ],
            [
              4.0,
              1.0
            ]
          ],
          "p": 0.25
        },
        "expected": [
          0.75,
          1.75,
          1.5,
          -0.1875
        ]
      },
      {
        "arguments": {
          "matrix": [
            [
              1.0,
              0.0
            ],
            [
              0.0,
              1.0
            ]
          ],
          "p": 0.5
        },
        "expected": [
          0.5,
          0.5,
          0.5,
          0.0
        ]
      },
      {
        "arguments": {
          "matrix": [
            [
              -2.0,
              -1.0
            ],
            [
              0.0,
              -3.0
            ]
          ],
          "p": 0.0
        },
        "expected": [
          -1.0,
          -3.0,
          -3.0,
          0.0
        ]
      }
    ],
    "explanation": "平均收益按两类频率加权；p=0 或 p=1 时两类型方程的边界不被推出区间。"
  },
  "p12-replicator-factor": {
