{
  "p12-ca-synchronous": {
    "cases": [
      {
        "arguments": {
          "state": [
            1,
            0,
            0,
            0
          ],
          "boundary": "periodic",
          "mode": "sync",
          "order": [
            0,
            1,
            2,
            3
          ]
        },
        "expected": [
          0,
          1,
          0,
          1
        ]
      },
      {
        "arguments": {
          "state": [
            1,
            0,
            0,
            0
          ],
          "boundary": "fixed",
          "mode": "sync",
          "order": [
            3,
            2,
            1,
            0
          ]
        },
        "expected": [
          0,
          1,
          0,
          0
        ]
      },
      {
        "arguments": {
          "state": [
            1,
            1,
            0
          ],
          "boundary": "periodic",
          "mode": "sync",
          "order": [
            1,
            0,
            2
          ]
        },
        "expected": [
          1,
          1,
          0
        ]
      }
    ],
    "explanation": "周期四格单脉冲向两边传播；固定边界的左端不从右端读值。"
  },
  "p12-old-state-buffer": {
