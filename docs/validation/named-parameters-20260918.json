          "unit": "U"
        },
        {
          "name": "ks",
          "type": "list[float]",
          "description": "要逐一比较的清除系数（elimination rate constant）；顺序也是结果的顺序。",
          "unit": "1/T"
        },
        {
          "name": "h",
          "type": "float",
          "description": "每次更新跨过的时间间隔。",
          "unit": "T"
        },
        {
          "name": "fraction",
          "type": "float",
          "description": "需要达到 target 的比例；例如 0.5 表示达到一半。",
          "unit": "无量纲"
        }
      ],
      "returns": [
        {
          "name": "inputs",
          "type": "list[float]",
          "description": "inputs[i] 是与 ks[i] 对应的恒定流入速率。",
          "unit": "U/T"
        },
        {
          "name": "first_times",
          "type": "list[float]",
          "description": "first_times[i] 是首次满足 A ≥ fraction·target 的离散时刻。",
          "unit": "T"
        }
      ],
      "constraints": [
        "0 < target ≤ 100；ks 有 1 到 20 项，每项 0 < k ≤ 1。",
        "0 < h ≤ 1，0 < fraction < 1，所有 k·h ≤ 1；给定条件保证 10000 步内到达阈值。",
        "两个返回列表与 ks 等长。每个实验都重新从零开始；返回网格上的首次到达时刻，不以连续时间公式代替。"
      ]
    },
