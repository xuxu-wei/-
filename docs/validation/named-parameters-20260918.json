          "unit": "U/T"
        },
        {
          "name": "k",
          "type": "float",
          "description": "清除系数（elimination rate constant）；物质量为 A 时，清除流率为 k·A。",
          "unit": "1/T"
        },
        {
          "name": "A0",
          "type": "float",
          "description": "计算开始时的物质量。",
          "unit": "U"
        },
        {
          "name": "h",
          "type": "float",
          "description": "每次更新跨过的时间间隔。",
          "unit": "T"
        },
        {
          "name": "steps",
          "type": "int",
          "description": "从初始时刻出发，需要执行的更新次数。",
          "unit": "步"
        }
      ],
      "returns": [
        {
          "name": "amounts",
          "type": "list[float]",
          "description": "包含 A0 和随后 steps 次更新结果，按时间顺序排列。",
          "unit": "U"
        }
      ],
      "constraints": [
        "0 ≤ u、A0 ≤ 100，0 ≤ k ≤ 1，0 < h ≤ 5；steps 是 1 到 100 的整数。",
        "返回列表长度为 steps+1，第一项为初值（initial condition）A0。",
        "k=0 时仍按同一更新式计算；大步长产生负值时保留负值。"
      ]
    },
